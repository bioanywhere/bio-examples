# Where the bio marketplace lives. Default = public bio host.
BIO_BASE_URL=https://bioanywhere.replit.app

# Port the agent listens on locally.
PORT=3000

# Public URL the agent is reachable at (set after you deploy).
# Used by scripts/register.ts when building the AgentCard.url field.
# Leave blank locally — the agent infers http://localhost:$PORT.
PUBLIC_BASE_URL=

# Filled in after you register at /integrate. The kit reads these
# in client/cli.ts so `pnpm demo` knows which agent to call.
BIO_AGENT_ID=

# Email shown to marketplace admins for recovery — used by scripts/register.ts.
CONTACT_EMAIL=

# --- Optional: real-LLM backend ---
# If OPENAI_API_KEY is set, the agent calls a real LLM. Otherwise it
# uses a deterministic stub (no key, no network). Set OPENAI_BASE_URL to
# point at the Replit AI Integrations proxy if you have it configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
